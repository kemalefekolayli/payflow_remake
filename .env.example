# Copy to .env and replace placeholders. Never commit real secrets.

# Auth and payment must use the same Base64-encoded HS256 key.
JWT_SECRET=replace-with-a-base64-encoded-key-of-at-least-32-bytes
JWT_EXPIRATION=3600000

# compose.yaml does not create Kafka.
# For Docker containers reaching a broker on the host:
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
KAFKA_CONSUMER_GROUP=notification-service

AUTH_DB_URL=jdbc:postgresql://localhost:5432/paytrans_auth
AUTH_DB_USERNAME=paytrans
AUTH_DB_PASSWORD=replace-with-local-auth-db-password
AUTH_SERVICE_PORT=8081

PAYMENT_DB_URL=jdbc:postgresql://localhost:5433/paytrans_payment
PAYMENT_DB_USERNAME=paytrans
PAYMENT_DB_PASSWORD=replace-with-local-payment-db-password
PAYMENT_SERVICE_PORT=8082

NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5434/paytrans_notification
NOTIFICATION_DB_USERNAME=paytrans
NOTIFICATION_DB_PASSWORD=replace-with-local-notification-db-password
NOTIFICATION_SERVICE_PORT=8083

OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_DELAY_MS=1000
OUTBOX_WORKER_BATCH_SIZE=10
OUTBOX_WORKER_MAX_RETRIES=5

NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_DELAY_MS=1000
NOTIFICATION_WORKER_BATCH_SIZE=10
NOTIFICATION_WORKER_MAX_RETRIES=5

